# Frankfurter's public API is keyless. This URL can point to a private
# Frankfurter-compatible endpoint if you self-host the provider.
AUTO_CURRENCY_EXCHANGE_ENABLED=true
AUTO_CURRENCY_EXCHANGE_API_BASE_URL=https://api.frankfurter.dev
AUTO_CURRENCY_EXCHANGE_REQUEST_TIMEOUT=10
AUTO_CURRENCY_EXCHANGE_INTERVAL_HOURS=24

# Optional JSON map of target market currency to decimal markup fraction.
# Example: {"EUR": 0.03, "JPY": 0.05} adds 3% to EUR and 5% to JPY.
AUTO_CURRENCY_EXCHANGE_MARKUPS={}
